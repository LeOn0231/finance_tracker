// Prisma Schema for Life Quest - Private Personal Quest & Finance Tracker

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. Single User Account (Admin Only)
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 2. Dream Purchase (Big Dreams & Small Dreams)
model DreamPurchase {
  id                  String                @id @default(cuid())
  name                String
  brand               String?
  category            String                @default("General") // Vehicles, Electronics, Collectibles, Gaming, Fashion, Books/Manga, Audio, Other
  type                String                @default("BIG_DREAM") // BIG_DREAM, SMALL_DREAM
  image               String?
  sourceUrl           String?
  sourceName          String?
  listedPrice         Float                 @default(0)
  finalPrice          Float                 @default(0)
  currency            String                @default("INR")
  priority            String                @default("A_TIER") // S_TIER, A_TIER, B_TIER, C_TIER, D_TIER
  status              String                @default("DREAMING") // DREAMING, PLANNING, SAVING, READY_TO_BUY, PURCHASED, ARCHIVED
  amountSaved         Float                 @default(0)
  monthlyContribution Float                 @default(0) // Monthly allocation from savings
  targetDate          DateTime?             // Target completion date for Big Dreams
  notes               String?
  specs               String?               // JSON formatted or plain text specifications
  isCurrentQuest      Boolean               @default(false)
  dateAdded           DateTime              @default(now())
  datePurchased       DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  transactions        PurchaseTransaction[]
  priceHistory        PriceHistory[]
  savingsAllocations  SavingsAllocation[]

  @@index([type])
  @@index([status])
  @@index([priority])
}

// 3. Price History Tracker
model PriceHistory {
  id        String        @id @default(cuid())
  dreamId   String
  price     Float
  currency  String        @default("INR")
  recordedAt DateTime     @default(now())
  notes     String?
  createdAt DateTime      @default(now())

  dream     DreamPurchase @relation(fields: [dreamId], references: [id], onDelete: Cascade)

  @@index([dreamId])
}

// 4. Financial Month (Income, Fixed Expenses, Savings, Safety Buffer, Dream Budget)
model FinancialMonth {
  id            String    @id @default(cuid())
  month         Int       // 1 - 12
  year          Int       // e.g. 2026
  baseIncome    Float     @default(0) // fallback base salary if no granular entries
  savingsTarget Float     @default(0)
  safetyBuffer  Float     @default(0)
  dreamBudget   Float     @default(0) // Optional dedicated monthly dream budget
  currency      String    @default("INR")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  incomes       IncomeEntry[]
  expenses      Expense[]
  allocations   SavingsAllocation[]
  transactions  PurchaseTransaction[]

  @@unique([month, year])
}

// 5. Granular Income Entries (Salary, Freelance, Bonus, Investment, Other)
model IncomeEntry {
  id               String          @id @default(cuid())
  date             DateTime        @default(now())
  source           String          @default("Salary") // Salary, Freelance, Bonus, Investment, Other
  description      String
  amount           Float           @default(0)
  financialMonthId String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  financialMonth   FinancialMonth  @relation(fields: [financialMonthId], references: [id], onDelete: Cascade)

  @@index([financialMonthId])
  @@index([source])
}

// 6. Savings Allocation Partitioning (Bike Fund, Car Fund, General Savings, Emergency)
model SavingsAllocation {
  id               String          @id @default(cuid())
  title            String          // e.g. "Royal Enfield Meteor Fund", "Emergency Buffer", "General Savings"
  amount           Float           @default(0)
  linkedDreamId    String?
  financialMonthId String
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  linkedDream      DreamPurchase?  @relation(fields: [linkedDreamId], references: [id], onDelete: SetNull)
  financialMonth   FinancialMonth  @relation(fields: [financialMonthId], references: [id], onDelete: Cascade)

  @@index([financialMonthId])
  @@index([linkedDreamId])
}

// 7. Expense Tracking (Fixed Monthly Recurring Expenses vs Actual Additional Spending)
model Expense {
  id               String          @id @default(cuid())
  date             DateTime        @default(now())
  description      String
  category         String          @default("General") // Rent/EMI, Food, Utilities, Transport, Subscriptions, Shopping, etc.
  amount           Float           @default(0)
  type             String          @default("FIXED") // FIXED, ADDITIONAL_SPENDING
  isRecurring      Boolean         @default(true)
  isPaid           Boolean         @default(false)
  linkedDreamId    String?
  financialMonthId String?
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  financialMonth   FinancialMonth? @relation(fields: [financialMonthId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([financialMonthId])
  @@index([category])
}

// 8. Purchase Transaction (Actual completed dream acquisitions)
model PurchaseTransaction {
  id               String          @id @default(cuid())
  date             DateTime        @default(now())
  description      String
  category         String          @default("Dream Purchase")
  amount           Float           @default(0)
  linkedDreamId    String?
  financialMonthId String?
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  linkedDream      DreamPurchase?  @relation(fields: [linkedDreamId], references: [id], onDelete: SetNull)
  financialMonth   FinancialMonth? @relation(fields: [financialMonthId], references: [id], onDelete: SetNull)

  @@index([linkedDreamId])
  @@index([financialMonthId])
}

// 9. Achievement Model
model Achievement {
  id          String    @id @default(cuid())
  code        String    @unique
  title       String
  description String
  icon        String?
  category    String    @default("DREAM") // DREAM, FINANCE, SAVINGS, SECRET
  unlockedAt  DateTime?
  progress    Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

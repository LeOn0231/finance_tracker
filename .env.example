# Life Quest — Environment Variables Template (.env.example)
# DO NOT COMMIT YOUR REAL .env FILE WITH ACTUAL SECRETS

# -------------------------------------------------------------
# 1. Database Connection (MySQL)
# -------------------------------------------------------------
# Local MySQL:
# DATABASE_URL="mysql://YOUR_USER:YOUR_PASSWORD@localhost:3306/YOUR_DATABASE"
#
# Managed Production MySQL (Aiven, PlanetScale, Railway, AWS RDS, DigitalOcean):
# DATABASE_URL="mysql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:3306/YOUR_DATABASE?sslaccept=strict"
DATABASE_URL="mysql://user:password@localhost:3306/lifequest"

# -------------------------------------------------------------
# 2. Authentication & Admin Security
# -------------------------------------------------------------
# Admin Authentication Secret (Used for signing JWT session tokens)
# Generate a strong 32+ char key with: openssl rand -base64 32
AUTH_SECRET="your-32-char-random-jwt-secret-key-goes-here"

# Initial Admin Credentials (used during database seeding / initial setup)
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@lifequest.local"
ADMIN_INITIAL_PASSWORD="your-strong-admin-password-here"

# -------------------------------------------------------------
# 3. Application Preferences
# -------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Life Quest"
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"

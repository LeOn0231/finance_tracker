# Life Quest — Private Application Environment Variables
# Configured for MySQL Production & Local Development

# -------------------------------------------------------------
# 1. Database Connection (MySQL)
# -------------------------------------------------------------
# Local Docker MySQL (default mapped port 3307):
# DATABASE_URL="mysql://quest_admin:QuestSecret2025!@localhost:3307/lifequest"
#
# Managed MySQL (PlanetScale, Aiven, Railway, AWS RDS, DigitalOcean, TiDB Serverless):
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE?sslaccept=strict"
DATABASE_URL="mysql://quest_admin:QuestSecret2025!@localhost:3307/lifequest"

# -------------------------------------------------------------
# 2. Authentication & Admin Security
# -------------------------------------------------------------
# Admin Authentication Secret (Used for signing JWT session tokens)
# Generate a strong 32+ char key with: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-secure-random-32-character-secret-in-production"

# Initial Admin Credentials (used during database seeding or auto-init)
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@lifequest.local"
ADMIN_INITIAL_PASSWORD="ChangeMeQuest2025!"

# -------------------------------------------------------------
# 3. Application Preferences
# -------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Life Quest"
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"
